# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-5.6-luna

# Optional. Leave unset to let the model use its own default: several current
# models support only their default temperature and reject the request outright
# rather than clamping it. Set it only for a model you know accepts it.
# LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=600

# Optional. Published provider rates per 1M tokens, used to estimate cost from
# token counts. Estimates only - they are labeled as such in the UI.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60

# --- Redis Iris ------------------------------------------------------------
# All Iris services are fully managed on Redis Cloud and must be created by
# hand in the console. See PLAN.md "Milestone 0" for the walkthrough.
# Leave these blank to run the app in stub mode.

# Set to "true" to force in-process fakes even when keys are present.
CONTEXTDESK_STUB_MODE=false

# Redis database (also used by the seed script to load synthetic data)
REDIS_URL=

# LangCache - semantic cache
LANGCACHE_ENDPOINT=
LANGCACHE_ID=
LANGCACHE_KEY=
# The bar a lookup must clear to count as a hit. Applied by the app, not by the
# service, so lowering it here is enough - no need to recreate the cache.
LANGCACHE_SIMILARITY_THRESHOLD=0.92
# How wide a lookup searches. Keep it below the threshold: the band between the
# two is what lets a miss report the score that produced it. The service's own
# threshold, fixed when it was created in the console, may clamp this - if
# misses keep arriving with no score at all, that clamp is why.
LANGCACHE_SEARCH_FLOOR=0.5

# Agent Memory - short-term session + long-term memory
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_KEY=
# Optional. How many memories to retrieve, and the score a scored memory must
# clear to reach the model.
MEMORY_RESULT_LIMIT=5
MEMORY_RELEVANCE_THRESHOLD=0.6

# Context Retriever - generated MCP tools over structured business data
CONTEXT_RETRIEVER_AGENT_KEY=
# Optional. Only needed to point the SDK at non-default hosts.
CONTEXT_RETRIEVER_API_URL=
CONTEXT_RETRIEVER_MCP_URL=

# --- Context assembly and telemetry ----------------------------------------
# The token budget the context builder assembles within. Anything past it is
# excluded, with the reason shown in the Context Inspector.
CONTEXT_BUDGET_TOKENS=1200
# How many execution records the in-process history keeps.
TELEMETRY_HISTORY_LIMIT=200
# The stubs score prompts by word overlap, which runs lower than embedding
# similarity, so they judge against their own bar rather than LangCache's.
STUB_SIMILARITY_THRESHOLD=0.6
