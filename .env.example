# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-5-luna

# --- Redis Iris ------------------------------------------------------------
# All Iris services are fully managed on Redis Cloud and must be created by
# hand in the console. See PLAN.md "Milestone 0" for the walkthrough.
# Leave these blank to run the app in stub mode.

# Set to "true" to force in-process fakes even when keys are present.
CONTEXTDESK_STUB_MODE=false

# Redis database (also used by the seed script to load synthetic data)
REDIS_URL=

# LangCache - semantic cache
LANGCACHE_ENDPOINT=
LANGCACHE_ID=
LANGCACHE_KEY=

# Agent Memory - short-term session + long-term memory
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_KEY=

# Context Retriever - generated MCP tools over structured business data
CONTEXT_RETRIEVER_AGENT_KEY=
